<?xml version="1.0" encoding="utf-8"?>
<!--
    One layout for every widget size. WidgetRenderer hides the quote, the title and the stats row
    when the widget is short, so nothing is ever cut off. Text that must fit a fixed space uses
    autosize with a fixed height, because autosize ignores wrap_content heights. Every view id
    the old code used is kept.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Pre-rounded background picture, drawn by WidgetRenderer so its corners match the card. -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/widget_moniker"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="THE PIRATE HUNTER"
            android:textColor="@color/katana_gold"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="@font/rampart_one"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="10sp"
            android:autoSizeStepGranularity="0.5sp" />

        <TextView
            android:id="@+id/widget_quote"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:alpha="0.75"
            android:text="&quot;Nothing happened.&quot;"
            android:textColor="@color/bandage_white"
            android:textSize="11sp"
            android:fontFamily="@font/rampart_one"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="0.5sp" />

        <!-- Steps and goal progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/stat_row_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_steps" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_steps"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="0 steps"
                    android:textColor="@color/bandage_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rampart_one"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="18sp"
                    android:autoSizeStepGranularity="0.5sp" />

                <TextView
                    android:id="@+id/widget_steps_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLADE SWINGS"
                    android:textColor="@color/katana_gold"
                    android:textSize="8sp"
                    android:fontFamily="@font/rampart_one"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="2dp"
                    android:max="10000"
                    android:progress="0"
                    android:progressBackgroundTint="@color/haramaki_green"
                    android:progressTint="@color/katana_gold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Distance, calories, active minutes side by side -->
        <LinearLayout
            android:id="@+id/widget_stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/stat_row_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:paddingTop="4dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <TextView
                    android:id="@+id/widget_distance"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0.00 km"
                    android:textColor="@color/bandage_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rampart_one"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeStepGranularity="0.5sp" />

                <TextView
                    android:id="@+id/widget_distance_label"
                    android:layout_width="match_parent"
                    android:layout_height="11dp"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="DOJO PATH"
                    android:textColor="@color/katana_gold"
                    android:textSize="9sp"
                    android:fontFamily="@font/rampart_one"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeStepGranularity="0.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/stat_row_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:paddingTop="4dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <TextView
                    android:id="@+id/widget_calories"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0 kcal"
                    android:textColor="@color/bandage_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rampart_one"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeStepGranularity="0.5sp" />

                <TextView
                    android:id="@+id/widget_calories_label"
                    android:layout_width="match_parent"
                    android:layout_height="11dp"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="CALORIES"
                    android:textColor="@color/katana_gold"
                    android:textSize="9sp"
                    android:fontFamily="@font/rampart_one"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeStepGranularity="0.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/stat_row_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="4dp"
                android:paddingTop="4dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <TextView
                    android:id="@+id/widget_active_min"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="0 min"
                    android:textColor="@color/bandage_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rampart_one"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeStepGranularity="0.5sp" />

                <TextView
                    android:id="@+id/widget_active_label"
                    android:layout_width="match_parent"
                    android:layout_height="11dp"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="ACTIVE"
                    android:textColor="@color/katana_gold"
                    android:textSize="9sp"
                    android:fontFamily="@font/rampart_one"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="9sp"
                    android:autoSizeStepGranularity="0.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty FrameLayout (a plain View is not allowed in widgets) pushes the buttons to the bottom when the widget is taller than its content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Buttons are FrameLayouts: a flat rounded picture (tinted per character) with a label on top.
                 A real Button loses its rounded look when recoloured from RemoteViews. -->
            <FrameLayout
                android:id="@+id/widget_btn_start"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_btn_start_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_btn_start_shape" />

                <TextView
                    android:id="@+id/widget_btn_start_label"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="START"
                    android:textColor="@color/bandage_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rampart_one" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_btn_stop"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_btn_stop_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_btn_stop_shape" />

                <TextView
                    android:id="@+id/widget_btn_stop_label"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="STOP"
                    android:textColor="@color/bandage_white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rampart_one" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
