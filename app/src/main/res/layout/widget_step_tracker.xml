<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Stable Background Image Layer -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/widget_moniker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THE PIRATE HUNTER"
            android:textColor="@color/katana_gold"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="@font/rampart_one"
            android:letterSpacing="0.2"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/widget_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&quot;Nothing happened.&quot;"
            android:textColor="@color/bandage_white"
            android:textSize="11sp"
            android:alpha="0.7"
            android:gravity="center"
            android:fontFamily="@font/rampart_one"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/stat_row_background"
            android:padding="8dp" android:layout_marginBottom="6dp"
            android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_steps"/>
            <LinearLayout
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:id="@+id/widget_steps" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 steps" android:textColor="@color/bandage_white" android:textSize="13sp" android:textStyle="bold"
                    android:fontFamily="@font/rampart_one"/>
                <TextView android:id="@+id/widget_steps_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="BLADE SWINGS" android:textColor="@color/katana_gold" android:textSize="8sp"
                    android:fontFamily="@font/rampart_one" android:visibility="gone"/>
                <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp"
                    android:progressTint="@color/katana_gold" android:progressBackgroundTint="@color/haramaki_green"
                    android:max="10000" android:progress="0"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/stat_row_background"
            android:padding="8dp" android:layout_marginBottom="6dp"
            android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_distance"/>
            <TextView android:id="@+id/widget_distance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="0.00 km" android:textColor="@color/bandage_white"
                android:textSize="12sp" android:textStyle="bold"
                android:fontFamily="@font/rampart_one"/>
            <TextView android:id="@+id/widget_distance_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DOJO PATH" android:textColor="@color/katana_gold" android:textSize="9sp"
                android:fontFamily="@font/rampart_one" android:alpha="0.6"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/stat_row_background"
            android:padding="8dp" android:layout_marginBottom="6dp"
            android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_calories"/>
            <TextView android:id="@+id/widget_calories" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="0 kcal" android:textColor="@color/bandage_white"
                android:textSize="12sp" android:textStyle="bold"
                android:fontFamily="@font/rampart_one"/>
            <TextView android:id="@+id/widget_calories_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CALORIES" android:textColor="@color/katana_gold" android:textSize="9sp"
                android:fontFamily="@font/rampart_one" android:alpha="0.6"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/stat_row_background"
            android:padding="8dp" android:gravity="center_vertical">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_heartbeat"/>
            <TextView android:id="@+id/widget_active_min" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="0 min" android:textColor="@color/bandage_white"
                android:textSize="12sp" android:textStyle="bold"
                android:fontFamily="@font/rampart_one"/>
            <TextView android:id="@+id/widget_active_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ACTIVE" android:textColor="@color/katana_gold" android:textSize="9sp"
                android:fontFamily="@font/rampart_one" android:alpha="0.6"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <Button
                android:id="@+id/widget_btn_start"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="START"
                android:textSize="10sp"
                android:backgroundTint="@color/haramaki_green"
                android:textColor="@color/onigiri_black"
                android:fontFamily="@font/rampart_one"
                android:padding="0dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/widget_btn_stop"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="STOP"
                android:textSize="10sp"
                android:backgroundTint="@color/blood_oath_red"
                android:textColor="@color/bandage_white"
                android:fontFamily="@font/rampart_one"
                android:padding="0dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
