<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/zoro_bg"
        android:alpha="0.78" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stat_row_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="9dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/widget_moniker"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1"
                    android:text="THE PIRATE HUNTER" android:textColor="@color/katana_gold"
                    android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_quote"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:alpha="0.85" android:maxLines="1" android:ellipsize="end"
                    android:text="Nothing happened." android:textColor="@color/bandage_white"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView android:id="@+id/widget_steps"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="0 steps"
                android:textColor="@color/bandage_white" android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="8dp" android:max="10000" android:progress="0"
            android:progressBackgroundTint="@color/haramaki_green"
            android:progressTint="@color/katana_gold" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/stat_row_background"
            android:orientation="horizontal" android:padding="9dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_distance" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0.00 km" android:textColor="@color/bandage_white" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_distance_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DISTANCE" android:textColor="@color/katana_gold" android:textSize="8sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_calories" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 kcal" android:textColor="@color/bandage_white" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_calories_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CALORIES" android:textColor="@color/katana_gold" android:textSize="8sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_active_min" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0 min" android:textColor="@color/bandage_white" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_active_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ACTIVE" android:textColor="@color/katana_gold" android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/widget_btn_start"
                android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
                android:layout_marginEnd="4dp" android:backgroundTint="@color/haramaki_green"
                android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
                android:text="START" android:textColor="@color/onigiri_black" android:textSize="10sp" />
            <Button android:id="@+id/widget_btn_stop"
                android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1"
                android:layout_marginStart="4dp" android:backgroundTint="@color/blood_oath_red"
                android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp"
                android:text="STOP" android:textColor="@color/bandage_white" android:textSize="10sp" />
        </LinearLayout>

        <TextView android:id="@+id/widget_steps_label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
